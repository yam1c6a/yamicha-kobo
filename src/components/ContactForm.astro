---
const email = 'contact@yamicha.com';
const directMail = `mailto:${email}?subject=${encodeURIComponent('やみちゃ工房へのお問い合わせ')}`;
---

<form class="contact-form" id="contact-form" action={directMail} method="post" enctype="text/plain" aria-describedby="contact-form-note">
  <div class="contact-form-pair">
    <div class="field"><label for="contact-name">お名前<span>必須</span></label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div>
    <div class="field"><label for="contact-email">メールアドレス<span>必須</span></label><input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required /></div>
  </div>
  <div class="field"><label for="contact-company">会社名・屋号<span>任意</span></label><input id="contact-company" name="company" autocomplete="organization" maxlength="200" /></div>
  <div class="field"><label for="contact-message">ご相談内容<span>必須</span></label><textarea id="contact-message" name="message" rows="6" maxlength="4000" placeholder="今の仕事、困っていること、相談したいことを自由に書いてください" required aria-describedby="contact-handoff-status"></textarea></div>
  <p class="handoff-notice" id="contact-handoff-note" hidden>AI相談室の内容を引き継げます。<button type="button" class="inline-button" id="contact-apply-handoff">相談内容に追加する</button></p>
  <p class="form-note" id="contact-handoff-status" role="status" aria-atomic="true"></p>
  <p class="form-note" id="contact-form-note">入力内容を確認して送信します。送信機能の準備中はメールアプリをご利用いただけます。<button type="button" class="inline-button" data-open-privacy>入力内容の取り扱い</button></p>
  <div class="contact-submit"><button class="button button-primary" type="submit">相談内容を確認する<img class="ui-icon" src="/icons/arrow-right.svg" alt="" width="24" height="24" /></button></div>
  <p class="direct-contact">直接メールでもご相談いただけます <a href={directMail}>{email}</a></p>
</form>

<dialog class="atelier-dialog" id="contact-preview" aria-labelledby="contact-preview-title">
  <div class="dialog-heading" id="contact-preview-heading"><p class="section-kicker">ご相談内容の確認</p><button type="button" class="icon-button" data-close-dialog aria-label="確認画面を閉じる"><img src="/icons/x.svg" alt="" width="24" height="24" /></button></div>
  <div id="contact-preview-content">
  <h2 id="contact-preview-title">この内容で、送信します。</h2>
  <p>宛先：<a href={directMail}>{email}</a></p>
  <label for="contact-preview-body">メール本文</label>
  <textarea id="contact-preview-body" rows="10" readonly></textarea>
  <p class="form-note">内容を確認して送信してください。</p>
  <div id="contact-turnstile" hidden></div><p id="contact-send-status" class="form-note" role="status" aria-live="polite"></p><div class="dialog-actions"><button type="button" class="button button-primary" id="contact-direct-send" hidden>この内容で送信する</button><a class="button button-primary" id="contact-mail-link" href={directMail}>メールアプリを開く<img class="ui-icon" src="/icons/arrow-up-right.svg" alt="" width="22" height="22" /></a><button class="text-link" type="button" id="copy-contact-body">本文をコピー<img class="ui-icon" src="/icons/copy.svg" alt="" width="20" height="20" /></button></div>
  <p class="copy-status" id="contact-copy-status" role="status"></p>
  <p class="form-note" id="contact-mail-fallback-note">メールアプリから送る場合は、本文をコピーして上記アドレスへお送りいただくこともできます。</p>
  <button type="button" class="inline-button" data-close-dialog>入力内容を修正する</button>
  </div>
  <section id="contact-success" aria-labelledby="contact-success-title" hidden>
    <h2 id="contact-success-title">送信しました</h2>
    <p>お問い合わせを受け付けました。</p>
    <button type="button" class="button button-primary" data-close-dialog>閉じる</button>
  </section>
</dialog>

<dialog class="atelier-dialog privacy-dialog" id="contact-privacy" aria-labelledby="contact-privacy-title">
  <div class="dialog-heading"><p class="section-kicker">ご相談について</p><button type="button" class="icon-button" data-close-dialog aria-label="入力内容の取り扱いを閉じる"><img src="/icons/x.svg" alt="" width="24" height="24" /></button></div>
  <h2 id="contact-privacy-title">入力内容の取り扱い</h2>
  <p>直接送信を利用する場合、入力内容とボット対策の認証情報をCloudflare Workersで処理し、Resendを通じてやみちゃ工房のメール窓口に送ります。問い合わせ本文はサイトのデータベースに保存しません。</p>
  <p>送信サービスの設定が未完了の場合は、従来どおり「メールアプリを開く」から送信できます。</p>
  <p>AI相談室へ送信した内容は、Cloudflare Workers AIでの応答処理に利用されます。詳細はAI相談室の「入力内容の取り扱い」をご覧ください。</p>
  <p>このサイトからGoogle Fontsのフォントを読み込みます。</p>
  <button type="button" class="button button-secondary" data-close-dialog>閉じる</button>
</dialog>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const preview = document.querySelector<HTMLDialogElement>('#contact-preview');
  const privacy = document.querySelector<HTMLDialogElement>('#contact-privacy');
  const body = document.querySelector<HTMLTextAreaElement>('#contact-preview-body');
  const mailLink = document.querySelector<HTMLAnchorElement>('#contact-mail-link');
  const message = document.querySelector<HTMLTextAreaElement>('#contact-message');
  const copyStatus = document.querySelector<HTMLElement>('#contact-copy-status');
  const previewContent = document.querySelector<HTMLElement>('#contact-preview-content');
  const successPanel = document.querySelector<HTMLElement>('#contact-success');
  const previewHeading = document.querySelector<HTMLElement>('#contact-preview-heading');
  const mailFallbackNote = document.querySelector<HTMLElement>('#contact-mail-fallback-note');
  const copyBody = document.querySelector<HTMLButtonElement>('#copy-contact-body');
  const handoffStatus = document.querySelector<HTMLElement>('#contact-handoff-status');

  function openDialog(dialog: HTMLDialogElement | null) {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    document.documentElement.classList.add('has-atelier-dialog');
  }

  document.querySelectorAll<HTMLDialogElement>('.atelier-dialog').forEach((dialog) => {
    dialog.querySelectorAll('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('close', () => document.documentElement.classList.remove('has-atelier-dialog'));
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const box = dialog.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
    });
  });
  document.querySelectorAll('[data-open-privacy]').forEach((button) => button.addEventListener('click', () => openDialog(privacy)));

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !body || !mailLink) return;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const sender = String(data.get('email') || '').trim();
    const company = String(data.get('company') || '').trim();
    const consultation = String(data.get('message') || '').trim();
    if (!name || !consultation) {
      const field = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(!name ? '#contact-name' : '#contact-message');
      field?.setCustomValidity('内容を入力してください。');
      field?.reportValidity();
      field?.addEventListener('input', () => field.setCustomValidity(''), { once: true });
      return;
    }
    const emailBody = ['やみちゃ工房 ご担当者さま', '', 'ホームページからご相談です。', '', `お名前：${name}`, `メールアドレス：${sender}`, ...(company ? [`会社名・屋号：${company}`] : []), '', '【ご相談内容】', consultation].join('\n');
    body.value = emailBody;
    mailLink.href = `mailto:contact@yamicha.com?subject=${encodeURIComponent('やみちゃ工房へのご相談')}&body=${encodeURIComponent(emailBody)}`;
    if (copyStatus) copyStatus.textContent = '';
    if (sendStatus) sendStatus.textContent = '';
    if (previewContent) previewContent.hidden = false;
    if (previewHeading) previewHeading.hidden = false;
    if (successPanel) successPanel.hidden = true;
    preview?.setAttribute('aria-labelledby', 'contact-preview-title');
    openDialog(preview);
    void prepareDirectSend();
  });

  document.querySelector('#copy-contact-body')?.addEventListener('click', async () => {
    if (!body || !copyStatus) return;
    try {
      await navigator.clipboard.writeText(body.value);
      copyStatus.textContent = '本文をコピーしました。';
    } catch {
      body.focus();
      body.select();
      copyStatus.textContent = '本文を選択しました。コピーしてご利用ください。';
    }
  });

  const directSend = document.querySelector<HTMLButtonElement>('#contact-direct-send');
  const sendStatus = document.querySelector<HTMLElement>('#contact-send-status');
  const turnstileHolder = document.querySelector<HTMLElement>('#contact-turnstile');
  type TurnstileAPI = { render: (element: HTMLElement, options: { sitekey: string; callback: (token: string) => void; 'expired-callback': () => void }) => string; reset: (id: string) => void };
  const turnstileWindow = window as typeof window & { turnstile?: TurnstileAPI };
  let token = '';
  let widgetId = '';
  let siteKey = '';
  async function loadTurnstile() {
    if (turnstileWindow.turnstile) return;
    await new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Turnstile unavailable'));
      document.head.appendChild(script);
    });
  }
  let configurationPromise: Promise<boolean> | null = null;
  async function getDirectSendReady(): Promise<boolean> {
    if (!configurationPromise) {
      configurationPromise = fetch('/api/contact', { cache: 'no-store' }).then(async (response) => {
        if (!response.ok) return false;
        const config = await response.json() as { ready?: boolean; siteKey?: string };
        const isReady = config.ready === true && typeof config.siteKey === 'string' && config.siteKey.length > 0;
        siteKey = isReady ? config.siteKey! : '';
        return isReady;
      }).catch(() => false).finally(() => { configurationPromise = null; });
    }
    return configurationPromise;
  }
  async function prepareDirectSend() {
    if (!turnstileHolder || !directSend || !sendStatus) return;
    sendStatus.textContent = '送信機能を確認しています…';
    // Always check when the dialog opens: the previous implementation raced
    // the initial configuration request and silently fell back to mailto.
    if (!(await getDirectSendReady())) {
      sendStatus.textContent = '直接送信を利用できません。メールアプリから送信してください。';
      if (mailLink) mailLink.hidden = false;
      if (copyBody) copyBody.hidden = false;
      if (mailFallbackNote) mailFallbackNote.hidden = false;
      return;
    }
    try {
      await loadTurnstile();
      if (!turnstileWindow.turnstile) throw new Error('Turnstile unavailable');
      if (!preview?.open || successPanel?.hidden === false) return;
      turnstileHolder.hidden = false;
      if (!widgetId) widgetId = turnstileWindow.turnstile.render(turnstileHolder, {
        sitekey: siteKey,
        callback: (value) => { token = value; },
        'expired-callback': () => { token = ''; },
      });
      else turnstileWindow.turnstile.reset(widgetId);
      token = '';
      directSend.hidden = false;
      if (mailLink) mailLink.hidden = true;
      if (copyBody) copyBody.hidden = true;
      if (mailFallbackNote) mailFallbackNote.hidden = true;
      sendStatus.textContent = '';
    } catch {
      if (mailLink) mailLink.hidden = false;
      if (copyBody) copyBody.hidden = false;
      if (mailFallbackNote) mailFallbackNote.hidden = false;
      directSend.hidden = true;
      sendStatus.textContent = '認証を読み込めません。メールアプリから送信してください。';
    }
  }
  directSend?.addEventListener('click', async () => {
    if (!form || !directSend || !sendStatus) return;
    if (!token) { sendStatus.textContent = '認証を完了してから送信してください。'; return; }
    const data = new FormData(form);
    directSend.disabled = true;
    sendStatus.textContent = '送信しています…';
    try {
      const response = await fetch('/api/contact', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'), email: data.get('email'), company: data.get('company'),
          message: data.get('message'), turnstileToken: token,
        }),
      });
      const result = await response.json() as { message?: string };
      sendStatus.textContent = result.message || '送信結果を確認できませんでした。';
      if (response.ok) {
        form.reset();
        token = '';
        if (widgetId) turnstileWindow.turnstile?.reset(widgetId);
        directSend.hidden = true;
        turnstileHolder?.setAttribute('hidden', '');
        if (previewContent) previewContent.hidden = true;
        if (previewHeading) previewHeading.hidden = true;
        if (successPanel) successPanel.hidden = false;
        preview?.setAttribute('aria-labelledby', 'contact-success-title');
        document.querySelector<HTMLButtonElement>('#contact-success [data-close-dialog]')?.focus();
      }
      else { token = ''; if (widgetId) turnstileWindow.turnstile?.reset(widgetId); }
    } catch { sendStatus.textContent = '通信に失敗しました。メールアプリからの送信も利用できます。'; }
    finally { directSend.disabled = false; }
  });

  function clipHandoffExcerpt(value: string, limit = 3400) {
    let excerpt = '';
    // Keep complete code points while respecting textarea's UTF-16 length limit.
    for (const codePoint of value) {
      if (excerpt.length + codePoint.length > limit) break;
      excerpt += codePoint;
    }
    return excerpt;
  }

  let handoffText = '';
  function applyHandoff() {
    if (!message || !handoffText) return;
    const combined = [message.value.trim(), handoffText].filter(Boolean).join('\n\n');
    if (combined.length > message.maxLength) {
      document.querySelector('#contact-handoff-note')?.removeAttribute('hidden');
      if (handoffStatus) handoffStatus.textContent = `合計が${message.maxLength}文字を超えるため、追加できません。入力済みの相談内容を短くしてから、もう一度「相談内容に追加する」を押してください。`;
      message.focus();
      return;
    }
    message.value = combined;
    message.setCustomValidity('');
    document.querySelector('#contact-handoff-note')?.setAttribute('hidden', '');
    if (handoffStatus) handoffStatus.textContent = 'AI相談室の内容を相談内容に追加しました。';
    handoffText = '';
  }
  window.addEventListener('yamicha:consultation-handoff', (event) => {
    const state = (event as CustomEvent).detail;
    if (!Array.isArray(state?.messages)) return;
    const questions = state.messages.filter((entry: {role?: string; content?: unknown}) => entry?.role === 'user' && typeof entry.content === 'string').map((entry: {content: string}) => entry.content);
    const excerpt = questions.join('\n\n');
    const clippedExcerpt = clipHandoffExcerpt(excerpt);
    handoffText = `【AI相談室で相談したこと】\n${clippedExcerpt}${excerpt.length > clippedExcerpt.length ? '\n（相談内容の一部を抜粋しています）' : ''}`;
    if (handoffStatus) handoffStatus.textContent = '';
    if (!message?.value.trim()) applyHandoff();
    else document.querySelector('#contact-handoff-note')?.removeAttribute('hidden');
  });
  document.querySelector('#contact-apply-handoff')?.addEventListener('click', applyHandoff);
</script>
