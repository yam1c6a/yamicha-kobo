---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['brand', { compact }]}>
	<span class="brand-mark" aria-hidden="true">
		<img src="/ym-icon.png?v=1" alt="" />
	</span>
	<span class="brand-name">やみちゃ工房</span>
</span>

<style>
	.brand { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); font-weight: 760; letter-spacing: 0.04em; white-space: nowrap; }
	.brand-mark { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; }
	.brand-mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 4px 8px rgb(0 59 128 / 14%)); }
	.compact .brand-mark { width: 2.15rem; height: 2.15rem; border-radius: 10px; }
</style>
