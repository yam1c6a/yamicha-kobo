---
import BrandMark from './BrandMark.astro';
import { CHAT_LIMITS } from '../services/ai/consultation-limits.js';
const suggestions = [
  ['AWSの構成', 'AWSで業務システムを動かすとき、構成はどう選べばよいですか？'],
  ['LLMの選び方', '社内でLLMを使う場合、APIとローカル運用をどう選べばよいですか？'],
  ['RAGの精度改善', '社内文書を検索するRAGが間違った回答をします。何から調べればよいですか？'],
  ['業務の自動化', '毎月、同じ列構成のExcelをまとめて集計しています。自動化できますか？'],
];
---
<section class="chat-card" aria-labelledby="chat-title">
  <div class="chat-topbar"><div class="chat-agent"><BrandMark compact /><span class="status"><span aria-hidden="true"></span>AI相談室</span></div><span class="private-note">会話本文はサイトに保存しません</span></div>
  <div class="chat-heading"><p class="eyebrow">システム開発・AI活用の技術相談</p><h2 id="chat-title">つくり方から、相談できます。</h2><p>AWS・LLM・RAGの構成や選び方、業務改善まで。</p></div>
  <div class="suggestion-list" aria-label="相談例">{suggestions.map(([label, question]) => <button type="button" class="suggestion" data-question={question}>{label}<span aria-hidden="true"> →</span></button>)}</div>
  <p class="knowledge-note">登録済みの技術ノートと公開実績を参照します。リアルタイムのWeb検索は行いません。</p>
  <div class="messages" id="chat-messages" role="log" aria-live="polite" aria-relevant="additions" aria-label="相談の会話">
    <div class="message assistant"><span class="message-icon" aria-hidden="true">AI</span><div class="bubble">こんにちは。システム開発やAI活用について、気になっていることを教えてください。技術の説明、選択肢の比較、構成の検討をお手伝いします。</div></div>
  </div>
  <div class="consultation-note" id="consultation-note" hidden><span>具体的な仕様・費用・納期は個別に確認できます。</span><a class="consultation-link" href="#contact">この内容で相談する →</a></div>
  <p class="chat-notice" id="chat-notice" role="alert" hidden></p>
  <form class="chat-form" id="chat-form">
    <label class="sr-only" for="chat-input">技術や業務の相談内容</label>
    <textarea id="chat-input" name="message" rows="2" maxlength={CHAT_LIMITS.userChars} placeholder="例：社内文書を検索するRAGを作りたい" required aria-describedby="chat-safety"></textarea>
    <button class="send-button" type="submit">送信 <span aria-hidden="true">↗</span></button>
  </form>
  <div class="chat-meta"><span id="turn-status">あと{CHAT_LIMITS.turns}回相談できます</span><span id="character-count">0 / {CHAT_LIMITS.userChars}</span></div>
  <p class="safety-note" id="chat-safety">個人情報・顧客情報・社外秘・APIキー・パスワードは入力しないでください。</p>
  <div class="chat-bottom"><span>AIの案内は参考情報です。料金・仕様は公式確認が必要です。</span><button type="button" id="chat-reset">新しい相談</button></div>
  <details class="privacy-details"><summary>入力内容の取り扱い</summary><p>送信内容はCloudflare Workers AIでの応答処理に利用されます。このサイトでは会話本文をサーバーに保存せず、ページ内で保持します。「この内容で相談する」を選んだ場合のみ、同じタブ内へ引き継ぎ情報を一時保存します。</p></details>
</section>
<script>import '../scripts/consultation-chat';</script>
<style>
  .chat-card { width: min(100%, 40rem); min-width: 0; padding: 1.1rem; border: 1px solid var(--line-strong); border-radius: 18px; background: #fff; color: var(--ink); box-shadow: 0 20px 55px #1237520c; }
  .chat-topbar, .chat-agent, .status, .chat-form, .chat-meta, .chat-bottom { display: flex; align-items: center; }
  .chat-topbar { flex-wrap: wrap; justify-content: space-between; gap: .7rem; padding: .2rem .2rem 1rem; border-bottom: 1px solid var(--line); }
  .chat-agent { gap: .7rem; flex-wrap: wrap; }
  .status { gap: .4rem; font-size: .72rem; font-weight: 700; color: var(--ink-soft); white-space: nowrap; }
  .status > span { width: .45rem; height: .45rem; border-radius: 50%; background: #369469; }
  .private-note { font-size: .65rem; color: var(--muted); }
  .chat-heading { padding: 1.4rem .3rem 1rem; }
  .chat-heading h2 { margin: .4rem 0 .6rem; font-size: clamp(1.25rem, 2.1vw, 1.65rem); line-height: 1.55; letter-spacing: 0; }
  .chat-heading > p:last-child { margin: 0; color: var(--ink-soft); font-size: .85rem; line-height: 1.8; }
  .suggestion-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
  .suggestion { display: flex; justify-content: space-between; align-items: center; gap: .3rem; min-height: 42px; padding: .65rem .75rem; border: 1px solid var(--pink-200); border-radius: 7px; background: var(--pink-50); color: var(--pink-700); font: inherit; font-size: .78rem; text-align: left; cursor: pointer; }
  .suggestion:hover { background: var(--pink-100); }
  .knowledge-note { margin: .8rem .3rem; color: var(--muted); font-size: .67rem; line-height: 1.8; }
  .messages { display: flex; flex-direction: column; gap: 1rem; min-height: 8rem; max-height: 30rem; overflow-y: auto; padding: 1rem .3rem; border-top: 1px solid var(--line); }
  .chat-card :global(.message) { display: flex; align-items: flex-start; gap: .5rem; min-width: 0; }
  .chat-card :global(.message.user) { justify-content: flex-end; }
  .chat-card :global(.message-icon) { display: grid; flex: 0 0 1.7rem; height: 1.7rem; place-items: center; border-radius: 7px; background: var(--pink-100); color: var(--pink-700); font-size: .66rem; font-weight: 700; }
  .chat-card :global(.bubble) { min-width: 0; max-width: calc(100% - 2.2rem); padding: .85rem 1rem; border-radius: 4px 13px 13px; background: #f1f6fa; color: var(--ink-soft); font-size: .86rem; line-height: 1.85; overflow-wrap: anywhere; }
  .chat-card :global(.bubble p) { margin: 0; white-space: pre-wrap; }
  .chat-card :global(.bubble ol) { padding-left: 1.2rem; margin: .8rem 0 0; }
  .chat-card :global(.user .bubble) { background: var(--ink); color: white; border-radius: 13px 4px 13px 13px; }
  .chat-card :global(.reply-sources) { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--line-strong); font-size: .72rem; }
  .chat-card :global(.reply-sources ul) { margin: .4rem 0 0; padding-left: 1.1rem; }
  .chat-card :global(.reply-sources li + li) { margin-top: .4rem; }
  .chat-card :global(.reply-sources a) { color: var(--pink-700); text-decoration: underline; text-underline-offset: .2em; }
  .chat-card :global(.reply-sources small) { display: block; color: var(--muted); }
  .chat-card :global(.source-notice) { margin-top: .8rem !important; font-size: .73rem; }
  .chat-card :global(.diagnosis-card) { margin-left: 2.2rem; padding: 1rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: .82rem; line-height: 1.85; }
  .chat-card :global(.diagnosis-card summary) { cursor: pointer; font-weight: 700; color: var(--pink-700); }
  .chat-card :global(.diagnosis-card h3) { margin: 1rem 0 .3rem; font-size: .82rem; }
  .chat-card :global(.diagnosis-card ul) { margin: 0; padding-left: 1.2rem; }
  .chat-card :global(.diagnosis-card p) { margin: .5rem 0 0; }
  .consultation-note { margin: .8rem 0; padding: .8rem; background: var(--pink-50); font-size: .8rem; line-height: 1.8; }
  .consultation-note > span { display: block; }
  .consultation-link { color: var(--pink-700); font-weight: 700; }
  .chat-notice { padding: .8rem; background: #fff1ef; color: #8a3428; font-size: .8rem; line-height: 1.7; }
  [hidden] { display: none !important; }
  .chat-form { gap: .6rem; padding: .55rem; margin-top: 1rem; border: 1px solid var(--line-strong); border-radius: 12px; }
  .chat-form:focus-within { outline: 2px solid var(--pink-400); outline-offset: 2px; }
  .chat-form textarea { flex: 1 1 auto; width: 100%; min-width: 0; max-height: 12rem; resize: vertical; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; font-size: .85rem; line-height: 1.7; }
  .send-button { display: inline-flex; flex: 0 0 auto; gap: .5rem; align-items: center; justify-content: center; min-width: 4.6rem; min-height: 46px; padding: .7rem; border: 0; border-radius: 8px; background: var(--ink); color: #fff; font: inherit; font-size: .83rem; font-weight: 700; white-space: nowrap; word-break: keep-all; cursor: pointer; }
  button:disabled { cursor: default; opacity: .55; }
  .chat-meta { justify-content: space-between; gap: .5rem; padding: .5rem .3rem 0; font-size: .65rem; color: var(--muted); }
  .safety-note { margin: .6rem .3rem; font-size: .68rem; line-height: 1.8; color: var(--ink-soft); }
  .chat-bottom { align-items: flex-start; justify-content: space-between; gap: .7rem; margin-top: .8rem; font-size: .65rem; line-height: 1.8; color: var(--muted); }
  #chat-reset { flex-shrink: 0; border: 0; padding: .25rem; background: none; color: var(--pink-700); font: inherit; text-decoration: underline; cursor: pointer; }
  .privacy-details { margin-top: .7rem; font-size: .65rem; line-height: 1.8; color: var(--muted); }
  .privacy-details summary { cursor: pointer; }
  .privacy-details p { margin: .4rem 0 0; }
  @media (max-width: 480px) { .chat-card { padding: .85rem; } .private-note { display: none; } .chat-card :global(.bubble) { padding: .7rem .8rem; } .chat-card :global(.diagnosis-card) { margin-left: 0; } .suggestion { padding-inline: .6rem; font-size: .72rem; } }
</style>
