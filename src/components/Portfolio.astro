const skills = [
  { name: 'アプリケーション・Web開発', text: 'C++ / Python / JavaScript / PHP / HTML / CSS' },
  { name: 'サーバー・データベース', text: 'FastAPI / Node.js / Jinja2 / Oracle / PostgreSQL / SQLite' },
  { name: 'AI連携・自動化', text: 'ローカルLLM連携 / Ollama / 外部API連携 / Playwright' },
