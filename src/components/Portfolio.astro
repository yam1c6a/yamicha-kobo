---
const projects = [
  {
    category: 'AI・業務自動化', title: 'ECサイト運営のAI管理・自動化システム',
    overview: 'ECサイト運営に必要な情報と操作をまとめる管理システム。AI連携と通常のプログラムを組み合わせて、日々の運営業務を支援します。',
    tech: ['Python', 'FastAPI', 'JavaScript', 'SQLite', 'Jinja2'],
    features: ['商品情報・価格・メッセージを一元管理', '外部APIとAIを連携した運営業務の自動化'],
    highlights: ['通常の処理とAIによる判断を分離し、用途に応じて組み合わせる構成', '管理画面から業務状況を確認できる仕組み'],
  },
  {
    category: 'AI基盤', title: 'AIエージェントの実行・制御基盤',
    overview: 'AIエージェント、ツール、記憶、ワークフローをつなぐ実行基盤。処理の制御と管理画面を一体で開発しました。',
    tech: ['Python', 'JavaScript', 'SQLite', 'AIエージェント'],
    features: ['AIエージェントと外部ツールの連携', '処理フローと実行状態の制御', '判断結果と根拠の管理'],
    highlights: ['AIの推論とツール実行を分離して制御する構成', '業務処理を段階的に実行・管理する基盤'],
  },
  {
    category: '対話・記憶管理', title: '対話・記憶管理システム',
    overview: 'ローカルLLMと連携し、会話の文脈や長期記憶を保持するシステム。記憶の更新や利用範囲を扱う仕組みを開発しました。',
    tech: ['Python', 'SQLite', 'Ollama'],
    features: ['会話履歴と長期記憶の保存', '記憶の訂正・忘却', 'Microsoft Teamsの情報収集とナレッジ化'],
    highlights: ['会話処理と記憶管理を分離した設計', '訂正や削除を扱う記憶ライフサイクル'],
  },
  {
    category: 'AI・文書管理', title: 'AIを活用した公開文書管理システム',
    overview: '公開文書を対象に、RAGによる自然文検索や自動分類を行う管理システムを開発しました。',
    tech: ['Python', 'FastAPI', 'React', 'TypeScript', 'PostgreSQL', 'pgvector', 'Ollama'],
    features: ['文書の取り込み・分割・ベクトル化', '自然文による文書検索', '文書の自動分類'],
    highlights: ['PostgreSQLとpgvectorを使った検索基盤', '検索結果を参照して回答するRAG構成'],
  },
  {
    category: 'GIS・地理空間', title: '地理空間データの世代管理システム',
    overview: '道路ネットワークの新設・廃止・形状変更を比較し、地理空間データの世代間差分を管理するシステム。既存機能の保守・拡張にも対応しました。',
    tech: ['C++'],
    features: ['道路ネットワークの世代間比較', '新設・廃止・形状変更の差分管理', 'ノード・リンクの変更検出'],
    highlights: ['地理空間データの構造を踏まえた差分判定', '長期運用を見据えた既存機能の保守・拡張'],
  },
  {
    category: 'GIS・アプリ開発', title: 'GISビューアアプリケーション',
    overview: '地理空間情報の表示、レイヤ管理、属性情報の参照、位置データの取り込みに対応するビューアを開発しました。',
    tech: ['C++'],
    features: ['地理情報のレイヤ表示', '図形と属性情報の参照', 'CSVの緯度経度からポイントを生成'],
    highlights: ['地理空間データと属性情報を関連付けた表示', '複数形式の地理情報を扱うデスクトップアプリケーション'],
  },
  {
    category: '業務システム', title: '経理システム',
    overview: '自治体向け経理システムの画面・サーバー処理を開発しました。',
    tech: ['PHP', 'JavaScript', 'Oracle Database'],
    features: ['経理業務向けの画面処理', 'サーバー側の業務ロジック', 'Oracle Databaseとのデータ連携'],
    highlights: ['画面とサーバーの両面を扱う業務システム構成', '既存の業務要件に沿った設計・実装'],
  },
  {
    category: 'ゲーム・移植', title: '海外ゲームのPC向け移植',
    overview: '海外ゲームの日本語化、画面・入力処理の調整、不具合修正に対応したPC向け移植開発。',
    tech: ['C++'],
    features: ['ゲーム内テキストの日本語化', '画面表示・入力処理の調整', '移植に伴う不具合の修正'],
    highlights: ['既存C++コードの解析と互換性調整', '移植先環境に合わせた動作修正'],
  },
];
const solutions = [
  { name: '業務に合わせたアプリケーション開発', text: 'デスクトップからWebまで、業務フローと運用環境に合わせて設計。既存システムの改修や機能拡張にも対応します。', tech: 'C++ / C# / VB / Java / Python / JavaScript / TypeScript / React' },
  { name: 'データをつなぐ基盤・API連携', text: 'データベース、Web API、外部サービスを連携し、情報を業務で活用できる仕組みを構築します。', tech: 'FastAPI / Node.js / Jinja2 / Oracle / PostgreSQL / SQLite / AWS EC2' },
  { name: '社内情報の検索・ナレッジ活用', text: '文書や対話の情報を整理し、検索・参照・回答につなげる仕組みを構築。用途に応じてローカルLLMも活用します。', tech: 'RAG / pgvector / Ollama / Microsoft Graph API / 外部API連携' },
  { name: '開発から運用・改善までの支援', text: '要件の整理から進捗・品質管理、稼働後の保守まで。実際の運用を踏まえ、継続して使えるシステムを支えます。', tech: '要件定義 / 設計・開発 / プロジェクト管理 / 運用・保守' },
];
---

<section class="section portfolio-section" id="works" aria-labelledby="portfolio-heading">
  <div class="shell">
    <div class="section-heading"><p class="eyebrow">CASE STUDIES</p><h2 id="portfolio-heading">開発実績</h2><p>業務システム、地理空間情報、AI・自動化。<br />実際の課題に向き合って開発した、システムの事例を紹介します。</p></div>
    <p class="portfolio-note">守秘義務に配慮し、発注元・サービス固有名・実画面・詳細仕様は公開せず、概要を紹介しています。</p>
    <div class="portfolio-grid">
      {projects.map((project, index) => (
        <article class="portfolio-card">
          <div class="portfolio-meta"><span>{project.category}</span><span>CASE {String(index + 1).padStart(2, '0')}</span></div>
          <h3>{project.title}</h3>
          <p class="portfolio-overview">{project.overview}</p>
          <details class="portfolio-details"><summary>主な機能・システムの特徴</summary><div class="portfolio-detail-content"><h4>主な機能</h4><ul>{project.features.map((feature) => <li>{feature}</li>)}</ul><h4>技術的な特徴</h4><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></div></details>
          <ul class="portfolio-tech" aria-label="使用技術">{project.tech.map((tech) => <li>{tech}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section skills-section" id="skills" aria-labelledby="skills-heading">
  <div class="shell skills-grid">
    <div class="section-heading"><p class="eyebrow">TECHNOLOGY & SOLUTIONS</p><h2 id="skills-heading">技術を組み合わせ、<br />解決につなげる。</h2><p>目的や既存環境に合わせて技術を選び、業務で使えるシステムへ。導入だけで終わらない、実用的なソリューションを提供します。</p></div>
    <dl class="skill-list">{solutions.map((solution) => <div><dt>{solution.name}</dt><dd>{solution.text}<span class="solution-tech">{solution.tech}</span></dd></div>)}</dl>
  </div>
</section>

<style>
  .portfolio-section { background: #f3f7fa; }
  .portfolio-note { max-width: 54rem; margin: -1rem 0 2rem; color: var(--muted); font-size: .78rem; line-height: 1.9; }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .portfolio-card { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line-strong); border-radius: 8px; background: #fff; }
  .portfolio-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--pink-700); font-size: .7rem; font-weight: 700; }
  .portfolio-meta span:last-child { color: var(--muted); font-family: Manrope, sans-serif; font-size: .6rem; letter-spacing: .08em; }
  .portfolio-card h3 { margin: 1.25rem 0 .9rem; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.6; overflow-wrap: anywhere; }
  .portfolio-overview { margin: 0; color: var(--ink-soft); font-size: .85rem; line-height: 1.95; }
  .portfolio-details { margin: 1.2rem 0 1.5rem; color: var(--ink-soft); font-size: .8rem; }
  .portfolio-details summary { width: fit-content; padding: .8rem 0; color: var(--pink-700); cursor: pointer; font-weight: 600; }
  .portfolio-details summary:focus-visible { outline: 2px solid var(--pink-700); outline-offset: 4px; }
  .portfolio-details ul { margin: .7rem 0 0; padding-left: 1.2rem; line-height: 1.9; }
  .portfolio-details li + li { margin-top: .4rem; }
  .portfolio-detail-content { padding: .35rem 0 .5rem; }
  .portfolio-detail-content h4 { margin: .9rem 0 .3rem; font-size: .8rem; color: var(--ink-soft); }
  .portfolio-tech { display: flex; flex-wrap: wrap; gap: .4rem; margin: auto 0 0; padding: 0; list-style: none; }
  .portfolio-tech li { padding: .35rem .55rem; border-radius: 3px; background: var(--pink-50); color: var(--ink-soft); font-size: .7rem; }
  .skills-section { background: #fff; }
  .skills-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 7vw, 6rem); }
  .skill-list { margin: 0; }
  .skill-list > div { padding: 1.4rem 0; border-top: 1px solid var(--line-strong); }
  .skill-list > div:last-child { border-bottom: 1px solid var(--line-strong); }
  .skill-list dt { margin-bottom: .7rem; font-size: .95rem; font-weight: 700; }
  .skill-list dd { margin: 0; color: var(--ink-soft); font-size: .85rem; line-height: 1.95; }
  .solution-tech { display: block; margin-top: .8rem; color: var(--muted); font-size: .72rem; }
  @media (max-width: 780px) { .portfolio-grid, .skills-grid { grid-template-columns: 1fr; } }
</style>
