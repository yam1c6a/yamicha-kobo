---
import ProjectDiagram from './ProjectDiagram.astro';
import { caseStudies } from '../data/case-studies.js';

const featured = [
  { id: 'ai-agent-platform', variant: 'agent', title: '業務を支援するAIエージェント', text: '取引や関連資料を照合し、勘定科目の候補や判断材料を提示します。税務上の最終判断は税理士が行います。' },
  { id: 'geospatial-versions', variant: 'roads', title: '道路データの比較・管理', text: '変更前後の道路データを比較し、新設・廃止・形状変更を検出して履歴を管理します。' },
  { id: 'ec-operations', variant: 'commerce', title: 'EC運営の業務自動化', text: '商品リサーチから出品・在庫管理、顧客対応まで、日々のEC運営を一つの画面で管理します。' },
] as const;

---

<section class="section portfolio-section" id="works" aria-labelledby="portfolio-heading">
  <div class="shell">
    <h2 class="section-title" id="portfolio-heading">開発に関わった実績</h2>
    <div class="featured-grid">
      {featured.map((project) => (
        <article class="featured-card">
          <ProjectDiagram variant={project.variant} />
          <h3>{project.title}</h3>
          <p>{project.text}</p>
          <a class="text-link" href={`#case-${project.id}`} data-case-link>
            詳しく見る<span class="sr-only">（{project.title}）</span><span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <details class="all-works disclosure" id="all-works">
      <summary>すべての開発実績を見る（{caseStudies.length}件）</summary>
      <p>守秘義務に配慮し、発注元・サービス固有名・実画面・非公開の詳細仕様は掲載していません。</p>
      <div class="portfolio-grid">
        {caseStudies.map((project) => (
          <article class="portfolio-card" tabindex="-1" id={`case-${project.id}`} aria-labelledby={`case-title-${project.id}`}>
            <div class="portfolio-meta"><span>{project.category}</span></div>
            <h3 id={`case-title-${project.id}`}>{project.title}</h3>
            <p class="portfolio-overview">{project.overview}</p>
            <dl class="portfolio-purpose"><dt>用途・目的</dt><dd>{project.purpose}</dd></dl>
            <details class="portfolio-details">
              <summary><span>機能・構成を詳しく見る<span class="sr-only">：{project.title}</span></span></summary>
              <div class="portfolio-detail-content">
                <section aria-labelledby={`case-functions-${project.id}`}>
                  <h4 id={`case-functions-${project.id}`}>主な機能</h4>
                  <dl class="case-feature-list">{project.features.map((feature) => <div><dt>{feature.title}</dt><dd>{feature.description}</dd></div>)}</dl>
                </section>
                <section aria-labelledby={`case-design-${project.id}`}>
                  <h4 id={`case-design-${project.id}`}>設計・実装のポイント</h4>
                  <ul class="case-design-list">{project.design.map((point) => <li>{point}</li>)}</ul>
                </section>
                <section aria-labelledby={`case-stack-${project.id}`}>
                  <h4 id={`case-stack-${project.id}`}>システム構成</h4>
                  <dl class="case-stack">{project.stack.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
                </section>
              </div>
            </details>
            <ul class="portfolio-tech" aria-label="主な使用技術">{project.tech.map((tech) => <li>{tech}</li>)}</ul>
          </article>
        ))}
      </div>
    </details>
  </div>
</section>

<script>
  const allWorks = document.querySelector<HTMLDetailsElement>('#all-works');

  function revealTarget(hash: string) {
    const target = document.getElementById(hash.slice(1));
    if (target && allWorks?.contains(target) && target.matches('.portfolio-card')) {
      const detail = target.querySelector('details');
      const wasHidden = !allWorks.open || !detail?.open;
      allWorks.open = true;
      if (detail) detail.open = true;
      return wasHidden ? target : null;
    }
    return null;
  }

  function revealLocation() {
    const target = revealTarget(location.hash);
    if (target) requestAnimationFrame(() => target.scrollIntoView());
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-case-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        const target = revealTarget(link.hash);
        if (target && link.hash === location.hash) target.scrollIntoView();
      }
    });
  });

  revealLocation();
  window.addEventListener('hashchange', revealLocation);
</script>

<style>
  .portfolio-section { background: var(--tint); }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .featured-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(.8rem, 1.35vw, 1rem);
    border: 1px solid #dce9f0;
    border-radius: 10px;
    background: #fff;
  }
  .featured-card h3 { margin: .8rem 0 .35rem; font-size: clamp(1rem, 1.75vw, 1.23rem); line-height: 1.5; font-weight: 800; }
  .featured-card p { flex-grow: 1; margin: 0; color: var(--ink-soft); font-size: .88rem; line-height: 1.75; }
  .featured-card a { margin-top: .2rem; }
  .all-works { margin-top: 1.25rem; border-bottom: 1px solid var(--line-strong); }
  .all-works > summary { color: var(--pink-700); }
  .all-works[open] { padding-bottom: 1.1rem; }
  .all-works .portfolio-grid { margin-top: .2rem; }
  .portfolio-card:target { border-color: #2392b4; }
  .portfolio-grid { display: grid; grid-template-columns: minmax(0, 1fr); align-items: stretch; gap: 1.25rem; }
  .portfolio-card { min-width: 0; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line-strong); border-radius: 8px; background: #fff; }
  .portfolio-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--pink-700); font-size: .72rem; font-weight: 700; }
  .portfolio-card h3 { margin: 1.25rem 0 .9rem; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.6; overflow-wrap: anywhere; }
  .portfolio-overview { margin: 0; color: var(--ink-soft); font-size: .9rem; line-height: 1.95; }
  .portfolio-purpose { margin: 1.25rem 0 0; padding: 1rem 1.1rem; border-left: 3px solid var(--pink-600); background: var(--pink-50); }
  .portfolio-purpose dt { color: var(--pink-700); font-size: .72rem; font-weight: 700; }
  .portfolio-purpose dd { margin: .4rem 0 0; color: var(--ink-soft); font-size: .85rem; line-height: 1.85; }
  .portfolio-details { margin: 1.2rem 0 1.5rem; color: var(--ink-soft); font-size: .85rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .portfolio-details summary { min-height: 48px; padding: .85rem .25rem; color: var(--pink-700); cursor: pointer; font-weight: 600; line-height: 1.7; }
  .portfolio-details summary:hover { color: var(--ink); }
  .portfolio-details summary:focus-visible { outline: 2px solid var(--pink-700); outline-offset: 4px; }
  .portfolio-detail-content { padding: .2rem 0 1.4rem; }
  .portfolio-detail-content > section + section { margin-top: 1.5rem; padding-top: 1.3rem; border-top: 1px solid var(--line); }
  .portfolio-detail-content h4 { margin: 0 0 .85rem; font-size: .9rem; color: var(--ink); }
  .case-feature-list { margin: 0; }
  .case-feature-list > div + div { margin-top: .95rem; }
  .case-feature-list dt { color: var(--ink); font-size: .84rem; font-weight: 600; }
  .case-feature-list dd { margin: .3rem 0 0; line-height: 1.9; }
  .case-design-list { margin: 0; padding-left: 1.2rem; line-height: 1.9; }
  .case-design-list li + li { margin-top: .65rem; }
  .case-design-list li::marker { color: var(--pink-600); }
  .case-stack { margin: 0; }
  .case-stack > div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: .75rem; padding: .75rem 0; border-bottom: 1px solid var(--line); }
  .case-stack > div:first-child { border-top: 1px solid var(--line); }
  .case-stack dt { color: var(--muted); font-size: .75rem; line-height: 1.9; }
  .case-stack dd { min-width: 0; margin: 0; font-size: .8rem; line-height: 1.9; overflow-wrap: anywhere; }
  .portfolio-tech { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .portfolio-tech li { padding: .35rem .55rem; border-radius: 3px; background: var(--pink-50); color: var(--ink-soft); font-size: .72rem; }
  @media (max-width: 720px) { .featured-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) {
    .portfolio-card { padding: 1.25rem; }
    .case-stack > div { grid-template-columns: 1fr; gap: .25rem; }
  }
</style>
