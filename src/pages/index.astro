---
import BrandMark from '../components/BrandMark.astro';
import ChatConsultation from '../components/ChatConsultation.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const services = [
	{ number: '01', title: '業務自動化', text: '入力・転記・集計・ファイル処理など、繰り返し行う定型作業を仕組みで減らします。', tags: ['定型作業', 'ワークフロー'] },
	{ number: '02', title: 'AI活用・AIシステム', text: '文書解析、分類、検索、情報整理など、AIが力を発揮する部分へ的確に組み込みます。', tags: ['生成AI', '文書解析'] },
	{ number: '03', title: 'データ処理', text: 'Excel・CSVをはじめとしたデータの集計、変換、整理、システム間の連携を行います。', tags: ['Excel / CSV', 'データ連携'] },
	{ number: '04', title: '業務システム・専用ツール', text: '市販サービスでは少し足りない業務に、必要な機能だけを備えた小さなシステムを作ります。', tags: ['専用ツール', 'システム開発'] },
];

const demos = [
	{ status: '公開中', active: true, category: 'AI CONSULTANT', title: '業務改善AIコンシェルジュ', text: '面倒な作業を入力すると、AIが内容を整理し、改善方法や自動化の可能性をご案内します。', label: 'このページで試す' },
	{ status: 'Coming Soon', active: false, category: 'ACCOUNTING AI', title: '請求書 → 経理処理AI', text: '請求書から取引先・金額・税を抽出し、確認できる仕訳候補へつなげるデモです。', label: '準備中' },
	{ status: 'Coming Soon', active: false, category: 'DATA CLEANING', title: 'CSV救済AI', text: '日付や金額、表記揺れが混在したデータを解析し、安全に整えるデモです。', label: '準備中' },
];
---

<Layout>
	<header class="site-header">
		<div class="shell header-inner">
			<a class="logo-link" href="#top" aria-label="やみちゃ工房 ホーム"><BrandMark /></a>
			<nav aria-label="メインナビゲーション">
				<a href="#services">できること</a><a href="#works">制作事例</a><a href="#demo">デモ</a><a href="#about">私たちについて</a>
			</nav>
			<a class="header-cta" href="#consult" data-focus-chat>相談する<span aria-hidden="true">↗</span></a>
		</div>
	</header>

	<main id="top">
		<section class="hero" id="consult">
			<div class="hero-decoration decoration-one" aria-hidden="true"></div><div class="hero-decoration decoration-two" aria-hidden="true"></div>
			<div class="shell hero-grid">
				<div class="hero-copy">
					<p class="hero-kicker"><span aria-hidden="true"></span>AI × SYSTEM × AUTOMATION</p>
					<h1>面倒な仕事を、<br /><em>仕組み</em>に変える。</h1>
					<p class="hero-lead">AI・システム開発・業務自動化を組み合わせて、<br class="desktop-only" />日々の「これ、もっと楽にならない？」を解決します。</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#consult" data-focus-chat>AIに相談してみる<span aria-hidden="true">→</span></a>
						<a class="button button-secondary" href="#works">制作・導入事例を見る</a>
					</div>
					<div class="hero-points" aria-label="やみちゃ工房の特徴">
						<span><i aria-hidden="true">✓</i>ざっくりした相談から</span><span><i aria-hidden="true">✓</i>AIありきにしない提案</span>
					</div>
				</div>
				<div class="hero-chat"><div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div><ChatConsultation /></div>
			</div>
			<div class="shell hero-footnote"><span>SCROLL TO EXPLORE</span><i aria-hidden="true"></i></div>
		</section>

		<section class="intro-strip" aria-label="事業方針">
			<div class="shell intro-grid">
				<p>手段からではなく、<br /><strong>困りごとから考える。</strong></p>
				<p>やみちゃ工房は、小さな課題にちょうどいい仕組みをつくるIT工房です。技術の名前を並べるよりも、まず「いま何が面倒なのか」を一緒に整理します。</p>
			</div>
		</section>

		<section class="section services" id="services">
			<div class="shell">
				<div class="section-heading"><p class="eyebrow">WHAT WE DO</p><h2>こんな「面倒」を、<br />仕組みにします。</h2><p>毎日の小さな手作業から、AIを組み込んだ業務システムまで。必要な分だけ、使い続けられる形で。</p></div>
				<div class="service-grid">
					{services.map((service) => (
						<article class="service-card">
							<div class="service-top"><span class="service-icon" aria-hidden="true">{service.number}</span><span class="service-arrow" aria-hidden="true">↗</span></div>
							<h3>{service.title}</h3><p>{service.text}</p><div class="tag-list">{service.tags.map((tag) => <span>{tag}</span>)}</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section work-section" id="works">
			<div class="shell">
				<div class="work-heading">
					<div class="section-heading"><p class="eyebrow">WORKS</p><h2>実際の業務で、<br />使えるものを。</h2></div>
					<p>見栄えだけでなく、現場で迷わず使えて、仕事が前に進むことを大切にしています。</p>
				</div>
				<article class="featured-work">
					<div class="work-visual" aria-hidden="true">
						<div class="document-stack doc-back"><span></span><span></span><span></span></div>
						<div class="document-stack doc-front"><div class="doc-head"><i></i><span>PUBLIC DOCUMENT</span></div><div class="doc-line wide"></div><div class="doc-line"></div><div class="doc-line short"></div><div class="doc-classification"><span>AI</span><i></i><i></i><i></i></div></div>
						<div class="scan-line"></div><div class="visual-label">DOCUMENT<br />INTELLIGENCE</div>
					</div>
					<div class="work-content">
						<div class="work-meta"><span class="case-label">導入事例</span><span>AI SYSTEM DEVELOPMENT</span></div>
						<h3>官公庁向け<br />公開文書管理AIシステム</h3>
						<p>大量の公開文書をAIで処理し、整理・分類・管理を支援するシステムを開発しました。</p>
						<dl><div><dt>担当範囲</dt><dd>要件整理 / 設計 / AI機能 / システム開発</dd></div><div><dt>技術要素</dt><dd>文書解析 / AI分類 / 検索 / データ管理</dd></div></dl>
						<p class="confidential">※守秘義務および情報保護のため、発注元・画面・詳細仕様等は公開していません。</p>
					</div>
				</article>
			</div>
		</section>

		<section class="section demo-section" id="demo">
			<div class="shell">
				<div class="section-heading demo-heading"><p class="eyebrow">TRY IT</p><h2>AIで何ができるのか、<br />実際に試せます。</h2><p>見るだけでなく、触って分かるデモを少しずつ増やしています。</p></div>
				<div class="demo-grid">
					{demos.map((demo, index) => (
						<article class:list={['demo-card', { active: demo.active }]}>
							<div class="demo-preview" aria-hidden="true"><span class="demo-number">0{index + 1}</span><div class="demo-symbol">{index === 0 ? '⌁' : index === 1 ? '¥' : '↹'}</div><span class:list={['demo-status', { live: demo.active }]}>{demo.status}</span></div>
							<div class="demo-content"><p class="demo-category">{demo.category}</p><h3>{demo.title}</h3><p>{demo.text}</p>{demo.active ? <a href="#consult" data-focus-chat>{demo.label}<span aria-hidden="true">→</span></a> : <span class="disabled-link" aria-label={`${demo.title}は準備中です`}>{demo.label}</span>}</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="philosophy" id="philosophy">
			<div class="philosophy-glow" aria-hidden="true"></div>
			<div class="shell philosophy-grid">
				<div><p class="eyebrow">OUR PHILOSOPHY</p><h2>AIを使うことが、<br /><em>目的ではありません。</em></h2></div>
				<div class="philosophy-copy"><p>AIが得意な仕事もあれば、通常のプログラムの方が速く、安く、安定して処理できる仕事もあります。</p><p>やみちゃ工房では、まず業務そのものを整理します。AI、プログラム、Excel、既存サービスなどから適した方法を選び、必要に応じて組み合わせます。</p><p class="philosophy-emphasis">目指しているのは「AIを導入すること」ではなく、<br /><strong>「仕事が楽になること」</strong>です。</p></div>
			</div>
		</section>

		<section class="section about-section" id="about">
			<div class="shell about-grid">
				<div class="about-title"><p class="eyebrow">ABOUT US</p><h2>小さなIT工房だから、<br />柔軟に。</h2><div class="about-mark" aria-hidden="true"><span>Y</span><i></i></div></div>
				<div class="about-content">
					<p class="about-lead">やみちゃ工房は、AI・システム開発・業務改善の技術を活用して、日々の業務をよりシンプルにする仕組みをつくるIT工房です。</p>
					<p>文書管理、データ処理、定型業務の自動化、AIを活用した業務支援など、現場で実際に使える仕組みづくりを大切にしています。</p><p>大掛かりなシステムだけでなく、「この作業だけ何とかしたい」といった小さな課題にも柔軟に対応します。</p>
					<dl class="business-info"><div><dt>事業内容</dt><dd>AI活用支援・システム開発・業務自動化</dd></div><div><dt>対応領域</dt><dd>文書管理 / データ処理 / バックオフィス業務</dd></div><div><dt>ご相談</dt><dd>まだ仕様が決まっていない段階から対応</dd></div></dl>
				</div>
			</div>
		</section>

		<section class="contact-section" id="contact">
			<div class="shell contact-card">
				<div class="contact-decoration" aria-hidden="true"><span></span><i></i></div><p class="eyebrow">CONTACT</p><h2>「これ、なんとかならない？」<br />からどうぞ。</h2><p>まだ仕様が決まっていなくても大丈夫です。<br />今困っていることを教えてください。どんな方法が考えられるか、一緒に整理します。</p>
				<div class="contact-actions"><a class="button button-primary" href="#consult" data-focus-chat>AIに相談してみる<span aria-hidden="true">→</span></a><a class="text-link" href="mailto:yam1c6a@gmail.com?subject=%E3%82%84%E3%81%BF%E3%81%A1%E3%82%83%E5%B7%A5%E6%88%BF%E3%81%B8%E3%81%AE%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B">メールで問い合わせる<span aria-hidden="true">↗</span></a></div>
			</div>
		</section>
	</main>

	<footer>
		<div class="shell footer-main"><div class="footer-brand"><BrandMark /><p>面倒な仕事を、仕組みに変える。</p></div><nav aria-label="フッターナビゲーション"><a href="#services">できること</a><a href="#works">制作事例</a><a href="#demo">デモ</a><a href="#philosophy">考え方</a><a href="#about">私たちについて</a></nav></div>
		<div class="shell footer-bottom"><small>© {new Date().getFullYear()} Yamicha Kobo</small><a href="#top">ページ上部へ ↑</a></div>
	</footer>
</Layout>
