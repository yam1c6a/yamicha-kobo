---
import ChatConsultation from '../components/ChatConsultation.astro';
import AtelierHero from '../components/AtelierHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Portfolio from '../components/Portfolio.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const navigation = [
  { href: '#services', label: 'できること' },
  { href: '#works', label: '仕事の紹介' },
  { href: '#about', label: '工房について' },
];
const services = [
  { id: 'ai-solutions', title: 'AI活用・業務自動化', text: ['探す、整理する、転記する。', '毎日の作業を、仕事に合う仕組みで支えます。'] },
  { id: 'system-development', title: '業務システムの開発', text: ['必要な機能と日々の運用を整理して、', '使いやすいシステムをつくります。'] },
  { id: 'legacy-maintenance', title: '既存システムの改修・保守', text: ['これまでの仕組みを理解し、', '必要なところから整えていきます。'] },
];
const solutions = [
  { name: 'AIエージェント・ナレッジ活用', text: '業務データや外部ツールを参照し、検索・回答・必要な処理につなげます。結果や根拠を人が確認する手順も設計します。', tech: 'RAG / Tool Calling / Ollama / Microsoft Graph API' },
  { name: '業務アプリケーションの開発・改修', text: 'デスクトップからWebまで、業務フローと運用環境に合わせて設計します。既存システムの保守や機能拡張にも対応します。', tech: 'C++ / C# / VB / Java / Python / JavaScript / TypeScript / React' },
  { name: 'データ基盤・外部サービスとの連携', text: 'データベースやWeb APIをつなぎ、情報を日々の業務で活用できる仕組みをつくります。', tech: 'FastAPI / Node.js / Oracle / PostgreSQL / SQLite / 外部API連携' },
  { id: 'cloud-aws', name: 'クラウド・AWS構築', text: 'AWSを活用したクラウド環境の構築や、既存システムとの連携・動作検証を支援します。', tech: 'AWS EC2 / クラウド・オンプレミスの基盤構築 / 運用・保守' },
];
const process = [
  { title: '今の仕事を知る', text: '困っていることも、変えたくないことも。今のやり方を聞くところから始めます。' },
  { title: '小さく確かめる', text: '必要な機能と対応範囲を整理して、使い方や実現方法を一緒に確認します。' },
  { title: '使いながら整える', text: '実際の運用を踏まえ、開発、その後の改修・保守まで支えます。' },
];
const questions = [
  { question: '仕様が決まっていなくても相談できますか？', answer: 'はい。手間がかかっている作業や、できるようにしたいことをお聞かせください。課題と必要な機能を整理するところからご相談いただけます。' },
  { question: '今使っているシステムも改修できますか？', answer: '既存システムの改修・機能追加・保守に対応します。利用中のシステムや運用環境を確認し、対応できる範囲を検討します。' },
  { question: 'AIを使う必要はありますか？', answer: '業務や運用環境に合わせ、通常のプログラムや既存サービス、AIから適した方法を選びます。組み合わせて使うこともできます。' },
];
const contactHref = 'mailto:contact@yamicha.com?subject=' + encodeURIComponent('やみちゃ工房へのお問い合わせ');
---

<Layout title="やみちゃ工房｜AI活用・業務自動化・システム開発" description="いつもの仕事に、ちょうどいいAIを。繰り返し作業の自動化から、業務システムの開発・改修、AWS構築まで。仕事の流れを理解し、使い続けられる仕組みをつくる技術工房です。" themeColor="#f4f0e7">
  <div class="atelier-site" id="top">
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="#top" aria-label="やみちゃ工房 ホーム"><span>やみちゃ工房</span><small>AI &amp; SOFTWARE STUDIO</small></a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="#contact">相談する</a>
        </nav>
        <details class="mobile-menu">
          <summary><span>メニュー</span><img class="menu-open-icon" src="/icons/list.svg" alt="" width="26" height="26" /><img class="menu-close-icon" src="/icons/x.svg" alt="" width="26" height="26" /></summary>
          <nav aria-label="モバイルナビゲーション">
            {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="#consult" data-focus-chat>AI相談室</a>
            <a href="#contact">仕事の困りごとを相談する</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <AtelierHero />

      <section class="section services" id="services" aria-labelledby="services-heading">
        <div class="shell section-rule">
          <div class="services-heading">
            <div><p class="section-kicker">できること</p><h2 class="section-title" id="services-heading">今の仕事に合う、つくり方を。</h2></div>
            <img class="service-botanical" src="/images/atelier/service-botanical.webp" alt="" width="900" height="450" loading="lazy" decoding="async" />
          </div>
          <div class="service-list">
            {services.map((service) => (
              <article class="service-row" id={service.id}>
                <h3>{service.title}</h3>
                <div><p>{service.text[0]}<br class="desktop-break" />{service.text[1]}</p></div>
              </article>
            ))}
          </div>
          <a class="text-link section-tail-link" href="#skills">対応できる技術について<img class="ui-icon" src="/icons/arrow-right.svg" alt="" width="22" height="22" /></a>
        </div>
      </section>

      <Portfolio />

      <section class="section about-section" id="about" aria-labelledby="about-heading">
        <div class="shell section-rule">
          <p class="section-kicker">工房について</p>
          <div class="about-grid">
            <div class="about-copy" id="philosophy">
              <h2 class="section-title" id="about-heading">つくる側と、使う側。<br />その両方の経験から。</h2>
              <p>システム開発に加え、経理や総務の実務にも<br class="desktop-break" />携わってきました。</p>
              <p>画面の向こうにある日々の仕事まで考えながら、<br class="desktop-break" />相談から開発、その後の改善まで向き合います。</p>
              <p class="studio-signature">やみちゃ工房は、ひとりの技術工房です。</p>
            </div>
            <img class="about-art" src="/images/atelier/studio-notebook.webp" alt="ノートと緑の鉛筆、葉を重ねた紙のコラージュ" width="1254" height="1254" loading="lazy" decoding="async" />
          </div>
          <div class="workshop-project" id="yamios">
            <p class="section-kicker">工房で育てているもの</p>
            <div class="project-introduction">
              <div><h3>YAMIOS</h3><p class="project-status">自主開発・開発中</p></div>
              <div><p>対話と記憶を通じて、<br class="desktop-break" />人の仕事を支えるAIの仕組みを開発しています。</p><a class="text-link" href="/yamios/">YAMIOSの概要と連携について<img class="ui-icon" src="/icons/arrow-up-right.svg" alt="" width="22" height="22" /></a></div>
            </div>
          </div>
          <details class="disclosure technical-solutions" id="skills">
            <summary>対応できる技術・開発範囲<img class="ui-icon disclosure-icon" src="/icons/caret-down.svg" alt="" width="22" height="22" /></summary>
            <dl class="skill-list">{solutions.map((solution) => <div id={solution.id}><dt>{solution.name}</dt><dd>{solution.text}<span>{solution.tech}</span></dd></div>)}</dl>
            <dl class="business-info" id="infrastructure"><div><dt>事業名</dt><dd>やみちゃ工房</dd></div><div><dt>連絡先</dt><dd><a href={contactHref}>contact@yamicha.com</a></dd></div></dl>
          </details>
        </div>
      </section>

      <section class="section process-section" aria-labelledby="process-heading">
        <div class="shell section-rule">
          <p class="section-kicker">仕事の進め方</p>
          <h2 class="section-title" id="process-heading">まず、仕事の話を聞かせてください。</h2>
          <div class="process-list">{process.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
          <div class="faq-list" aria-label="ご相談の前によくあるご質問">{questions.map(({question, answer}) => <details class="disclosure"><summary>{question}<img class="ui-icon disclosure-icon" src="/icons/caret-down.svg" alt="" width="22" height="22" /></summary><p>{answer}</p></details>)}</div>
        </div>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="shell section-rule">
          <div class="contact-heading-grid">
            <div class="contact-intro"><p class="section-kicker">ご相談</p><h2 class="section-title" id="contact-heading"><span>「こんなこと、できる？」</span><span>からで大丈夫。</span></h2><p>まだ仕様が決まっていなくても、<br />今の仕事や困っていることから聞かせてください。</p></div>
            <img class="contact-botanical" src="/images/atelier/service-botanical.webp" alt="" width="900" height="450" loading="lazy" decoding="async" />
          </div>
          <ContactForm />
          <details class="consultation-disclosure" id="consult">
            <summary><span><small>まずは気軽に</small>AI相談室で考えを整理する</span><img class="ui-icon disclosure-icon" src="/icons/caret-down.svg" alt="" width="26" height="26" /></summary>
            <div class="consultation-content"><p class="consultation-intro">AWS・LLM・RAGの構成や選び方、業務改善について、普段の言葉で相談できます。具体的な仕様・費用・納期は、個別のご相談で確認します。</p><ChatConsultation /></div>
          </details>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="shell footer-inner"><a class="wordmark footer-wordmark" href="#top" aria-label="やみちゃ工房 ホーム"><span>やみちゃ工房</span><small>AI &amp; SOFTWARE STUDIO</small></a><nav aria-label="フッターナビゲーション"><a href="#about">工房について</a><a href="#skills">事業者情報</a><button type="button" class="inline-button" data-open-privacy>入力内容の取り扱い</button><a href="#consult" data-focus-chat>AI相談室</a></nav><small class="copyright">© {new Date().getFullYear()} Yamicha Kobo</small></div></footer>
  </div>
</Layout>

<script>
  const skills = document.querySelector<HTMLDetailsElement>('#skills');
  const consultation = document.querySelector<HTMLDetailsElement>('#consult');
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  function revealTarget() {
    if (['#skills', '#cloud-aws', '#infrastructure'].includes(location.hash) && skills) skills.open = true;
    if (location.hash === '#consult' && consultation) consultation.open = true;
    const target = document.getElementById(location.hash.slice(1));
    if (target && !location.hash.startsWith('#case-')) requestAnimationFrame(() => target.scrollIntoView({block:'start'}));
  }
  if (location.hash) revealTarget();
  window.addEventListener('hashchange', revealTarget);
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (link?.hash === '#consult' && consultation) consultation.open = true;
    if (link && ['#skills', '#cloud-aws', '#infrastructure'].includes(link.hash) && skills) skills.open = true;
    if (menu?.open && !menu.contains(event.target)) menu.open = false;
  }, true);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {menu.open = false;}));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {menu.open = false; menu.querySelector('summary')?.focus();}
  });
</script>
