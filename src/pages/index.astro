---
import BrandMark from '../components/BrandMark.astro';
import ChatConsultation from '../components/ChatConsultation.astro';
import Portfolio from '../components/Portfolio.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const services = [
  { id: 'system-development', icon: 'system', title: '手作業を減らしたい', text: '繰り返す入力や集計、ファイル処理を自動化。今あるシステムの改修や、ツール同士の連携にも対応します。' },
  { id: 'ai-solutions', icon: 'documents', title: '必要な文書を探したい', text: '増え続ける文書を整理し、必要な情報を検索・参照できる仕組みをつくります。' },
  { id: 'geospatial', icon: 'gis', title: '地図データを活用したい', text: '位置情報と業務データを地図で確認。地図ビューアや、道路データの差分比較・履歴管理を支援します。' },
] as const;

const navigation = [
  { href: '#services', label: '相談できること' },
  { href: '#works', label: '開発実績' },
  { href: '#about', label: '事業紹介' },
];

const solutions = [
  { name: '業務に合わせたアプリケーション開発', text: 'デスクトップからWebまで、業務フローと運用環境に合わせて設計。既存システムの改修や機能拡張にも対応します。', tech: 'C++ / C# / VB / Java / Python / JavaScript / TypeScript / React' },
  { name: 'データをつなぐ基盤・API連携', text: 'データベース、Web API、外部サービスを連携し、情報を業務で活用できる仕組みを構築します。', tech: 'FastAPI / Node.js / Jinja2 / Oracle / PostgreSQL / SQLite / AWS EC2' },
  { name: '社内情報の検索・ナレッジ活用', text: '文書や対話の情報を整理し、検索・参照・回答につなげる仕組みを構築。用途に応じてローカルLLMも活用します。', tech: 'RAG / pgvector / Ollama / Microsoft Graph API / 外部API連携' },
  { name: '開発から運用・改善までの支援', text: '要件の整理から進捗・品質管理、稼働後の保守まで。実際の運用を踏まえ、継続して使えるシステムを支えます。', tech: '要件定義 / 設計・開発 / プロジェクト管理 / 運用・保守' },
];

const consultationTopics = [
  { title: '現状の課題', text: '手間がかかる作業や、利用中のツールを確認します。' },
  { title: '対応する範囲', text: '改善したいことと、優先する機能を整理します。' },
  { title: '費用と期間', text: '機能や既存環境を踏まえ、見積もりに必要な条件を確認します。' },
  { title: '開発と運用', text: '確認方法や、稼働後の使い方・保守について話し合います。' },
];

const questions = [
  { question: '仕様が決まっていなくても相談できますか？', answer: 'はい。手間がかかっている作業や、できるようにしたいことをお聞かせください。課題と必要な機能を整理するところからご相談いただけます。' },
  { question: '今使っているシステムも改修できますか？', answer: '既存システムの改修・機能追加・保守に対応します。利用中のシステムや運用環境を確認し、対応できる範囲を検討します。' },
  { question: 'AIを使う必要はありますか？', answer: '業務や運用環境に合わせ、通常のプログラムや既存サービス、AIから適した方法を選びます。組み合わせて使うこともできます。' },
];

const contactEmail = 'contact@yamicha.com';
const contactHref = 'mailto:' + contactEmail + '?subject=' + encodeURIComponent('やみちゃ工房へのお問い合わせ');
---

<Layout
  title="やみちゃ工房｜業務システム開発・AI・地図データ活用"
  description="既存システムの改善から、AI・地図データの活用まで。やみちゃ工房は、業務に合わせた仕組みづくりを支援します。"
  themeColor="#ffffff"
>
  <div class="corporate-site" id="top">
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="logo-link" href="#top" aria-label="やみちゃ工房 ホーム"><BrandMark /></a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="header-cta" href="#contact">お問い合わせ</a>
        </nav>
        <details class="mobile-menu">
          <summary><span class="menu-lines" aria-hidden="true"></span><span>メニュー</span></summary>
          <nav aria-label="モバイルナビゲーション">
            {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="#contact">お問い合わせ</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">業務システム / AI / 地理空間</p>
            <h1 id="hero-heading">業務の手間を減らす。<br />必要な情報を、<br /><span>使える形に。</span></h1>
            <p class="hero-lead">既存システムの改善から、AI・地図データの活用まで。業務に合わせた仕組みづくりを支援します。</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#contact">業務の困りごとを相談する <span aria-hidden="true">→</span></a>
              <a class="text-link" href="#works">開発実績を見る <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <ProjectDiagram variant="hero" />
        </div>
      </section>

      <section class="section services" id="services" aria-labelledby="services-heading">
        <div class="shell">
          <h2 class="section-title" id="services-heading">こんな課題をご相談いただけます</h2>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card" id={service.id}>
                <ServiceIcon name={service.icon} />
                <div>
                  <h3>{service.title}</h3>
                  <p>{service.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Portfolio />

      <section class="section about-section" id="about" aria-labelledby="about-heading">
        <div class="shell">
          <h2 class="section-title" id="about-heading">やみちゃ工房について</h2>
          <div class="about-grid">
            <div class="about-identity">
              <img src="/ym-logo.png" alt="" width="104" height="104" loading="lazy" decoding="async" />
              <div>
                <p>やみちゃ工房</p>
                <span>業務システム開発・AI・地理空間情報</span>
              </div>
            </div>
            <div class="about-content" id="philosophy">
              <p>やみちゃ工房は、業務システム開発、地理空間情報の活用、AI・業務自動化を手がけるIT開発事業です。お客様の業務や運用環境に合わせ、企画・設計から開発・運用まで支援します。</p>
              <dl class="business-info">
                <div id="infrastructure"><dt>対応範囲</dt><dd>新規開発、既存システムの改修・機能追加、データ連携、クラウド・オンプレミスの基盤構築、運用・保守</dd></div>
                <div><dt>連絡先</dt><dd><a href={contactHref}>{contactEmail}</a></dd></div>
              </dl>
              <details class="disclosure technical-solutions" id="skills">
                <summary>技術・ソリューション</summary>
                <dl class="skill-list">
                  {solutions.map((solution) => (
                    <div>
                      <dt>{solution.name}</dt>
                      <dd>{solution.text}<span>{solution.tech}</span></dd>
                    </div>
                  ))}
                </dl>
              </details>
            </div>
          </div>
        </div>
      </section>

      <section class="section consultation-topics" aria-labelledby="topics-heading">
        <div class="shell">
          <h2 class="section-title" id="topics-heading">相談時に確認すること</h2>
          <ol class="topic-list">
            {consultationTopics.map((topic, index) => (
              <li>
                <span class="topic-step" aria-hidden="true">{index + 1}</span>
                <h3>{topic.title}</h3>
                <p>{topic.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section faq-section" aria-labelledby="faq-heading">
        <div class="shell faq-grid">
          <h2 class="section-title" id="faq-heading">よくあるご質問</h2>
          <div class="faq-list">
            {questions.map(({ question, answer }) => (
              <details class="disclosure">
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section consultation-section" id="consult" aria-labelledby="consult-heading">
        <div class="shell consultation-grid">
          <div>
            <h2 class="section-title" id="consult-heading">AI相談室</h2>
            <p>「この作業を自動化したい」「AIで何ができる？」など、普段の言葉で入力すると、課題や改善方法を整理できます。</p>
            <p class="consultation-disclaimer">AIによるご案内は参考情報です。具体的な仕様・費用・納期は、個別のご相談で確認します。</p>
            <a class="text-link" href="#contact">直接お問い合わせする <span aria-hidden="true">→</span></a>
          </div>
          <ChatConsultation />
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="shell contact-card">
          <h2 id="contact-heading">今、手間がかかっていることを教えてください。</h2>
          <p>今困っている作業、利用中のツール、できるようにしたいことを、わかる範囲でお知らせください。仕様が決まっていない段階からご相談いただけます。</p>
          <div class="contact-actions">
            <a class="button button-primary" href={contactHref}>メールでお問い合わせ <span aria-hidden="true">→</span></a>
            <a class="contact-email" href={contactHref}>{contactEmail}</a>
          </div>
          <a class="text-link" href="#consult" data-focus-chat>AI相談室で考えを整理する <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="logo-link" href="#top" aria-label="やみちゃ工房 ホーム"><BrandMark compact /></a>
        <nav aria-label="フッターナビゲーション">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="#consult" data-focus-chat>AI相談室</a>
        </nav>
        <small>© {new Date().getFullYear()} Yamicha Kobo</small>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const skills = document.querySelector<HTMLDetailsElement>('#skills');
  function revealSkills() {
    if (location.hash === '#skills' && skills) skills.open = true;
  }
  revealSkills();
  window.addEventListener('hashchange', revealSkills);

  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
