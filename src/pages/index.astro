---
import BrandMark from '../components/BrandMark.astro';
import ChatConsultation from '../components/ChatConsultation.astro';
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.astro';
import '../styles/home.css';

const services = [
	{ number: '01', title: 'システム開発', text: '業務内容や運用に合わせた業務システム・専用アプリケーションを設計・開発します。既存システムの改修や保守にも対応します。', tags: ['業務システム', 'アプリケーション'] },
	{ number: '02', title: 'AI・業務自動化', text: '生成AIやAIエージェントを業務に組み込み、文書解析・情報検索・判断支援・定型作業の自動化を実現します。', tags: ['生成AI', 'AIエージェント'] },
	{ number: '03', title: 'Web・API開発', text: 'Webアプリケーションや管理画面、APIを開発し、既存サービスや外部システムとの連携を支援します。', tags: ['Webアプリ', 'API連携'] },
	{ number: '04', title: 'データ活用・連携', text: 'データの収集・変換・集計から、データベース設計やシステム間連携まで、業務に合わせたデータ活用を支援します。', tags: ['データベース', 'データ連携'] },
];

---

<Layout title="やみちゃ工房" description="AIシステム・業務システム・Web開発・業務自動化に取り組むやみちゃ工房の事業内容と開発実績をご紹介します。">
	<header class="site-header">
		<div class="shell header-inner">
			<a class="logo-link" href="#top" aria-label="やみちゃ工房 ホーム"><BrandMark /></a>
			<nav aria-label="メインナビゲーション">
				<a href="#services">事業内容</a><a href="#works">開発実績</a><a href="#skills">技術領域</a><a href="#about">工房について</a>
			</nav>
			<a class="header-cta" href="#contact">相談する<span aria-hidden="true">↗</span></a>
		</div>
	</header>

	<main id="top">
		<section class="hero" id="consult">
			<div class="hero-decoration decoration-one" aria-hidden="true"></div><div class="hero-decoration decoration-two" aria-hidden="true"></div>
			<div class="shell hero-grid">
				<div class="hero-copy">
					<p class="hero-kicker"><span aria-hidden="true"></span>SYSTEM DEVELOPMENT & AI</p>
					<h1>業務を知り、<br /><em>仕組み</em>をつくる。</h1>
					<p class="hero-lead">C++の開発・長期保守から、AI連携・業務自動化まで。<br class="desktop-only" />業務課題に合わせた、使い続けられるシステムを開発します。</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#works">開発実績を見る<span aria-hidden="true">→</span></a>
						<a class="button button-secondary" href="#consult" data-focus-chat>AIに相談してみる</a>
					</div>
					<div class="hero-points" aria-label="やみちゃ工房の特徴">
						<span><i aria-hidden="true">✓</i>開発から長期保守まで</span><span><i aria-hidden="true">✓</i>業務に合わせた設計・開発</span>
					</div>
				</div>
				<div class="hero-chat"><div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div><ChatConsultation /></div>
			</div>
			<div class="shell hero-footnote"><span>SCROLL TO EXPLORE</span><i aria-hidden="true"></i></div>
		</section>

		<section class="intro-strip" aria-label="事業方針">
			<div class="shell intro-grid">
				<p>技術ありきではなく、<br /><strong>課題に合う方法を選ぶ。</strong></p>
				<p>やみちゃ工房は、システム開発とAI活用を通じて、業務上の課題を解決するIT開発事業です。現状の業務や運用環境を把握し、実用性と継続性を重視した仕組みを提案・開発します。</p>
			</div>
		</section>

		<section class="section services" id="services">
			<div class="shell">
				<div class="section-heading"><p class="eyebrow">WHAT WE DO</p><h2>課題に合わせた、<br />システムと仕組みを。</h2><p>業務システム、Webアプリケーション、AI連携、データ活用。課題や運用環境を確認し、必要な技術を組み合わせて開発します。</p></div>
				<div class="service-grid">
					{services.map((service) => (
						<article class="service-card">
							<div class="service-top"><span class="service-icon" aria-hidden="true">{service.number}</span><span class="service-arrow" aria-hidden="true">↗</span></div>
							<h3>{service.title}</h3><p>{service.text}</p><div class="tag-list">{service.tags.map((tag) => <span>{tag}</span>)}</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<Portfolio />


		<section class="philosophy" id="philosophy">
			<div class="philosophy-glow" aria-hidden="true"></div>
			<div class="shell philosophy-grid">
				<div><p class="eyebrow">OUR PHILOSOPHY</p><h2>AIを使うことが、<br /><em>目的ではありません。</em></h2></div>
				<div class="philosophy-copy"><p>AIが得意な仕事もあれば、通常のプログラムの方が速く、安く、安定して処理できる仕事もあります。</p><p>やみちゃ工房では、まず業務そのものを整理します。AI、プログラム、Excel、既存サービスなどから適した方法を選び、必要に応じて組み合わせます。</p><p class="philosophy-emphasis">目指しているのは「AIを導入すること」ではなく、<br /><strong>「仕事が楽になること」</strong>です。</p></div>
			</div>
		</section>

		<section class="section about-section" id="about">
			<div class="shell about-grid">
				<div class="about-title"><p class="eyebrow">ABOUT</p><h2>課題の整理から、<br />開発・運用まで。</h2><div class="about-mark" aria-hidden="true"><img src="/ym-logo.png" alt="" /><i></i></div></div>
				<div class="about-content">
					<p class="about-lead">やみちゃ工房は、業務システム開発、Webアプリケーション開発、AI活用・業務自動化を中心に、課題に応じたシステムを企画・設計・開発するIT開発事業です。</p>
					<p>業務システムやGIS関連アプリケーションの開発・長期保守で培った経験を基盤に、近年はRAGによる文書検索、対話・記憶管理、AIエージェント基盤、EC運営支援など、AIを活用したシステム開発にも取り組んでいます。</p><p>新規開発だけでなく、既存システムの改修・機能追加・保守、業務フローの見直しや自動化まで、構想段階からご相談いただけます。</p>
					<dl class="business-info"><div><dt>事業内容</dt><dd>システム開発・AI活用支援・業務自動化</dd></div><div><dt>対応領域</dt><dd>業務システム / Webアプリ・API / AI連携 / データ活用 / 開発・保守</dd></div><div><dt>ご相談</dt><dd>まだ仕様が決まっていない段階から対応</dd></div></dl>
				</div>
			</div>
		</section>

		<section class="contact-section" id="contact">
			<div class="shell contact-card">
				<div class="contact-decoration" aria-hidden="true"><span></span><i></i></div><p class="eyebrow">CONTACT</p><h2>システム開発・業務改善の<br />ご相談はこちら。</h2><p>新規システムの開発、既存システムの改修、AI活用や業務自動化など。<br />構想段階・仕様検討中のご相談も承ります。</p>
				<div class="contact-actions"><a class="button button-primary" href="mailto:contact@yamicha.com?subject=%E3%82%84%E3%81%BF%E3%81%A1%E3%82%83%E5%B7%A5%E6%88%BF%E3%81%B8%E3%81%AE%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B">メールで相談する<span aria-hidden="true">→</span></a></div>
				<p class="contact-email"><a href="mailto:contact@yamicha.com?subject=%E3%82%84%E3%81%BF%E3%81%A1%E3%82%83%E5%B7%A5%E6%88%BF%E3%81%B8%E3%81%AE%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B">contact@yamicha.com</a></p>
			</div>
		</section>
	</main>

	<footer>
		<div class="shell footer-main"><div class="footer-brand"><BrandMark /><p>面倒な仕事を、仕組みに変える。</p></div><nav aria-label="フッターナビゲーション"><a href="#services">事業内容</a><a href="#works">開発実績</a><a href="#skills">技術領域</a><a href="#philosophy">考え方</a><a href="#about">工房について</a></nav></div>
		<div class="shell footer-bottom"><small>© {new Date().getFullYear()} Yamicha Kobo</small><a href="#top">ページ上部へ ↑</a></div>
	</footer>
</Layout>
