# Optional overrides. Workers AI does not require an API key in application code.
AI_PROVIDER=workers-ai
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# One model call per request. Larger limits may increase inference charges.
CONSULTATION_MAX_OUTPUT_TOKENS=2400

# Optional: route Workers AI through an existing AI Gateway.
# AI_GATEWAY_ID=default
